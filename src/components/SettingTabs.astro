---
interface Props {
    id: string;
    label: string;
    options: [[string, string], [string, string]];
}

const { id, label, options } = Astro.props;
---

<div class="setting-tabs" {id}>
    <span id={`${id}-label`}>{label}</span>
    <div class="tabs" role="radiogroup" aria-labelledby={`${id}-label`}>
        {options.map(([value, option], index) => (
            <>
                <input id={`${id}-${value}`} type="radio" name={id} {value} checked={index === 0} />
                <label for={`${id}-${value}`}>{option}</label>
            </>
        ))}
    </div>
</div>

<script>
    document.querySelectorAll<HTMLElement>(".setting-tabs").forEach((setting) => {
        const inputs = Array.from(setting.querySelectorAll<HTMLInputElement>('input[type="radio"]'));
        const selected = inputs.find((input) => input.value === localStorage.getItem(setting.id)) ?? inputs[0];
        selected.checked = true;
        document.documentElement.setAttribute("data-" + setting.id, selected.value);
        setting.addEventListener("change", (event) => {
            if (!(event.target instanceof HTMLInputElement)) return;
            document.documentElement.setAttribute("data-" + setting.id, event.target.value);
            localStorage.setItem(setting.id, event.target.value);
        });
    });
</script>

<style>
    .setting-tabs {
        display: grid;
        grid-template-columns: 4.75rem minmax(0, 1fr);
        align-items: center;
        gap: 0.375rem;
    }
    .setting-tabs > span {
        font-size: 0.875rem;
    }
    .tabs {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 3px;
        position: relative;
        padding: 3px;
        border-radius: 999px;
        background: rgb(var(--cmblack));
    }
    .tabs::before {
        content: "";
        position: absolute;
        top: 3px;
        bottom: 3px;
        left: 3px;
        width: calc((100% - 9px) / 2);
        border-radius: 999px;
        background: #666;
        transition: transform 180ms ease;
        pointer-events: none;
    }
    .tabs:has(input:last-of-type:checked)::before {
        transform: translateX(calc(100% + 3px));
    }
    input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
    }
    label {
        position: relative;
        z-index: 1;
        padding: 0.4rem 0;
        border-radius: 999px;
        color: #c0c0c0;
        font-size: 0.75rem;
        line-height: 1;
        text-align: center;
        cursor: pointer;
    }
    input:checked + label, label:hover {
        color: white;
    }
    input:focus-visible + label {
        outline: 2px solid white;
        outline-offset: 2px;
    }
</style>
