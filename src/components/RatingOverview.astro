---
import { ratings } from "../base";
import type { validRating } from "../zod";
import Rater from "./Rater";
---

<div>
    {ratings.map((text, rating) => <Rater {text} rating={rating as validRating} />)}
</div>

<style>
    div {
        display: flex;
        flex-flow: row wrap;
        justify-content: space-evenly;
        align-items: center;
        gap: 0.25em 1.5ch;
        font-size: 1.35em;
        white-space: nowrap;
    }
    @media screen and (width <= 800px) {
        :global(body:not(.screenshot)) div {
            justify-content: space-between;
        }
    }
</style>
