---
import { ratings } from "../base";
import Rater from "./Rater.astro";
---

<div class="rc">
    {ratings.map(([n], i) => <Rater rating={i}>{n}</Rater>)}
</div>

<style>
    div.rc {
        flex-grow: 1;
        display: flex;
        flex-flow: row wrap;
        justify-content: space-evenly;
        align-items: center;
        column-gap: 1.5ch;
        font-size: 1.35em;
    }
    @media screen and (width <= 800px) {
        :global(body:not(.screenshot)) div.rc {
            justify-content: space-between;
        }
    }
</style>
