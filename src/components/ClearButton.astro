---
import { Button } from "cmdesigns";
import Dialog from "./Dialog.astro";

interface Props {
    store: string;
}

const { store } = Astro.props;
---

<button type="button" data-store={store}>Clear</button>
<Dialog>
    Are you sure you want to clear your ratings? This action is irreversible.
    <span data-clear-error role="alert"></span>
    <Button slot="buttons" data-close>Cancel</Button>
    <Button slot="buttons" variant="danger">Clear</Button>
</Dialog>

<script>
    import { showDialog } from "../dialog";

    document.querySelectorAll<HTMLButtonElement>("button[data-store]").forEach((button) => {
        const dialog = button.nextElementSibling as HTMLDialogElement;
        const error = dialog.querySelector("[data-clear-error]")!;
        button.addEventListener("click", () => {
            error.textContent = "";
            showDialog(dialog, button);
        });
        dialog.querySelector<HTMLButtonElement>("button:last-child")!.addEventListener("click", () => {
            try {
                window.localStorage.removeItem(button.dataset.store!);
            } catch {
                error.textContent = "Couldn't clear your ratings. Browser storage is unavailable.";
                return;
            }
            window.location.reload();
        });
    });
</script>

<style>
    [data-clear-error] {
        display: block;
    }
    button[data-store] {
        border: 0;
        padding: 0;
        background: none;
        font: inherit;
        text-align: inherit;
    }
</style>
