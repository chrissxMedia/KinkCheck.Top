---
import { Button, Field, Select } from "cmdesigns";
import { matchingWeights, type MatchingWeights } from "../base";

interface Props {
    id: string;
    other?: string;
    weights?: MatchingWeights;
}

const { id, other, weights = "flat" } = Astro.props;
---

<form action={`/internal/checks/${encodeURIComponent(id)}/match`} method="get">
    <Field id="match-check-id" name="other" label="Match with" type="text"
        value={other} placeholder="Check ID" required />
    <label>
        Weights
        <Select class="weights" name="weights">
            {Object.entries(matchingWeights).map(([value, { name }]) => (
                <option {value} selected={weights === value}>{name}</option>
            ))}
        </Select>
    </label>
    <Button type="submit">Match</Button>
</form>

<style>
    form {
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        justify-content: center;
        gap: 0.75rem;
        margin: 1rem;
    }
    :global(body.screenshot) form {
        display: none;
    }
    label {
        display: flex;
        flex-direction: column;
        gap: 0.3em;
        min-width: 0;
    }
    form > :global(div) {
        min-width: 0;
        margin: 0;
    }
    .weights {
        padding: 0.5em 0.6em;
    }
</style>
