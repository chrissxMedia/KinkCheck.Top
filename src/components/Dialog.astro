---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"dialog">;
---

<dialog {...Astro.props} data-dialog>
    <p><slot /></p>
    <div><slot name="buttons" /></div>
</dialog>

<script>
    document.querySelectorAll<HTMLDialogElement>("dialog[data-dialog]").forEach((dialog) => {
        dialog.addEventListener("click", (event) => {
            if (event.target === dialog && event.currentTarget === dialog) {
                dialog.close();
            }
        });
        dialog.querySelectorAll<HTMLButtonElement>("button[data-close]").forEach((button) => {
            button.addEventListener("click", () => dialog.close());
        });
    });
</script>

<style>
    dialog {
        background-color: black;
        border: 1px solid white;
        border-radius: 0.5em;
    }
    dialog::backdrop {
        background-color: rgba(0, 0, 0, 0.5);
    }
    p {
        font-family: var(--sans-serif);
        margin: 0;
    }
    div {
        display: flex;
        flex-direction: row-reverse;
        margin-top: 0.5em;
    }
</style>
