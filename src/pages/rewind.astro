---
import HeaderLogo from "../components/HeaderLogo.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Rewind" screenshotOptions={{ width: 1000 }}>
    <HeaderLogo slot="header">Rewind</HeaderLogo>
    <main>
        <p>Click on the text to edit it.</p>
        <div class="sexrewind column">
            <div class="column">
                <span class="sextext1">You had sex</span>
                <span class="sextimes editable" contenteditable spellcheck="false">0 times</span>
                <span class="sextext2">this year</span>
            </div>
            <span class="sexdesc editable" contenteditable spellcheck="false">You absolute fucking loser...</span>
            <div class="sexstats">
                <div class="column">
                    <span class="sexminstext">Minutes had sex</span>
                    <span class="sexminsnum editable" contenteditable spellcheck="false">0</span>
                </div>
                <div class="column">
                    <span class="sexminstext">Partners</span>
                    <span class="sexminsnum editable" contenteditable spellcheck="false">0</span>
                </div>
            </div>
        </div>
    </main>
</Layout>

<style>
    main {
        font-size: min(12pt, 1.5vw);
    }

    p {
        text-align: center;
        color: gray;
        padding-bottom: 0.5em;
    }

    .column {
        display: flex;
        flex-direction: column;
    }

    .editable {
        outline: none;
        caret-color: #a9337e;
        border-radius: 0.1em;
        cursor: text;
    }

    .editable:focus {
        background-color: rgba(169, 51, 126, 0.18);
    }

    .sexrewind {
        width: 7.5em;
        height: 7.5em;
        background-color: #b6fbed;
        color: #a9337e;
        font-size: 8em;
        font-family: var(--sans-serif);
        font-weight: bold;
        padding: 0.2em;
        justify-content: space-between;
    }

    .sextimes, .sexdesc, .sexminstext, .sexminsnum {
        text-align: center;
    }

    .sextimes {
        font-weight: bolder;
        color: black;
        font-size: 1.2em;
    }

    .sextext2 {
        text-align: end;
    }

    .sexdesc {
        font-size: .35em;
    }

    .sexstats {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
    }

    .sexminstext {
        font-size: .45em;
        color: #5e9abc;
    }

    .sexminsnum {
        color: #d78f52;
        font-weight: bolder;
    }

    :global(div#content) {
        max-width: max-content;
    }
</style>
