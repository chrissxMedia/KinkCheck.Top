---
import HeaderLogo from "../../components/HeaderLogo.astro";
import Rater from "../../components/Rater.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="Merch Designs"
    screenshotOptions={{ width: 200, scale: 20 }}
>
    <div class="c">
        <HeaderLogo />
        <div class="b">
            <Rater rating={1} />
        </div>
    </div>
    <Rater rating={2}>bottom</Rater>
    <Rater rating={2.5}>top</Rater>
</Layout>

<style>
    :global(div#content) {
        width: max-content;
        font-size: 16pt;
    }

    .c :global(h1) {
        font-size: 1em;
    }

    .b {
        padding-left: 8px;
    }

    .c {
        display: flex;
        flex-direction: row;
    }
</style>
