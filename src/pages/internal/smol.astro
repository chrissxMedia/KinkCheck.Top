---
import Layout from "../../layouts/Layout.astro";
import HeaderLogo from "../../components/HeaderLogo.astro";
import KinkCheck from "../../components/KinkCheck.svelte";
import RatingOverview from "../../components/RatingOverview.astro";
import { getCurrentTemplate } from "../../db";

const template = await getCurrentTemplate("kcc");
if (!template) {
	throw new Error(`cant find template (should never happen, our db is f-ed)`);
}
---

<Layout screenshotOptions={{ windowWidth: 1000 }}>
	<header>
		<HeaderLogo includeVersion={false}>
			<span class="smol">v{template.revision}</span>
		</HeaderLogo>
		<RatingOverview />
	</header>
	<KinkCheck {...template.data} client:load />
</Layout>

<style>
	:global(div#content) {
		min-width: 250px;
		max-width: 900px;
        font-size: 6pt;
	}
	header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
	}
</style>
