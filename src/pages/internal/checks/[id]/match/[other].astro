---
import Layout from "../../../../../layouts/Layout.astro";
import HeaderLogo from "../../../../../components/HeaderLogo.astro";
import RatingOverview from "../../../../../components/RatingOverview.astro";
import { getCheck, getTemplateVersion } from "../../../../../db";
import { decodeKinkCheck, type kinkcheck } from "../../../../../base";
import { Check } from "../../../../../components/KinkCheck";
import type { validRating } from "../../../../../zod";
import ErrorPage from "../../../../../layouts/ErrorPage.astro";

export const prerender = false;
const { id, other } = Astro.params;
const a = id && (await getCheck(id));
const b = other && (await getCheck(other));

const template = a && b && a.template_id == b.template_id
    ? await getTemplateVersion(a.template_id, a.template_revision)
    : undefined;
const err = !a || !b
    ? { status: 404, title: "Check not found", detail: "The check does not exist." }
    : a.template_id != b.template_id
      ? { status: 400, title: "Incompatible checks", detail: "Incompatible checks (different templates)" }
      : !template
        ? { status: 404, title: "Template not found", detail: "Template not found" }
        : undefined;
if (err) Astro.response.status = err.status;

function matchRating(a: validRating, b: validRating): validRating {
    if (!a || !b) return a || b;
    if (a == 5 || b == 5) return 5;
    return (Math.round(a + b) / 2) as validRating;
}

// TODO: testing
function match(
    { ratings: a }: kinkcheck,
    { ratings: b }: kinkcheck,
): kinkcheck {
    return {
        ratings: a.map((rA, cat) =>
            rA.map((rsA, kink) =>
                rsA.map((ratA, pos) => matchRating(ratA, b[cat][kink][pos])),
            ),
        ),
    };
}

let matched: kinkcheck | undefined;
if (a && b && template) {
    const kcA = decodeKinkCheck(template, a.data);
    const kcB = decodeKinkCheck(template, b.data);
    kcB.ratings = kcB.ratings.map((ks) => ks.map((rs) => rs.toReversed()));
    matched = match(kcA, kcB);
}
---

{err ? <ErrorPage {...err}><a href="/">Start a new check</a></ErrorPage> : a && b && template && matched && <Layout title="Matcher">
    {/* FIXME: the header has really bad spacing issues apparent here */}
    <HeaderLogo slot="header">
        <span class="smol">
            {template.name}&nbsp;v{template.revision}
            {" "}{a.id}&nbsp;matched&nbsp;with&nbsp;{b.id}
        </span>
    </HeaderLogo>
    <RatingOverview slot="header" />
    <p>The resulting KinkCheck is written from {a.id}'s perspective.</p>
    <Check kinks={template.kinks} {...matched} />
</Layout>}

<style>
    :global(div#content) {
        min-width: 475px;
        max-width: 1800px;
    }
    p {
        width: fit-content;
        margin: 1em auto;
    }
</style>
