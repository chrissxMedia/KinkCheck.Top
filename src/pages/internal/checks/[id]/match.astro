---
import Layout from "../../../../layouts/Layout.astro";
import HeaderLogo from "../../../../components/HeaderLogo.astro";
import RatingOverview from "../../../../components/RatingOverview.astro";
import MatchForm from "../../../../components/MatchForm.astro";
import { getCheck, getTemplateVersion } from "../../../../db";
import { decodeKinkCheck, match, matchingWeights, type kinkcheck, type MatchingWeights } from "../../../../base";
import { Check } from "../../../../components/KinkCheck";
import ErrorPage from "../../../../layouts/ErrorPage.astro";

export const prerender = false;
const { id } = Astro.params;
const other = Astro.url.searchParams.get("other")?.trim();
const requestedWeights = Astro.url.searchParams.get("weights") ?? "flat";
const weights = Object.keys(matchingWeights).find((key) => key === requestedWeights) as MatchingWeights | undefined;
const a = id && (await getCheck(id));
const b = other && (await getCheck(other));

const template = a && b && a.template_id == b.template_id
    ? await getTemplateVersion(a.template_id, a.template_revision)
    : undefined;
const err = !weights
    ? { status: 400, title: "Unknown weights", detail: "Choose weights from the check page." }
    : !a || !b
      ? { status: 404, title: "Check not found", detail: "The check does not exist." }
      : a.template_id != b.template_id
        ? { status: 400, title: "Incompatible checks", detail: "Incompatible checks (different templates)" }
        : !template
          ? { status: 404, title: "Template not found", detail: "Template not found" }
          : undefined;
if (err) Astro.response.status = err.status;

let matched: kinkcheck | undefined;
if (a && b && template && weights) {
    const kcA = decodeKinkCheck(template, a.data);
    const kcB = decodeKinkCheck(template, b.data);
    kcB.ratings = kcB.ratings.map((ks) => ks.map((rs) => rs.toReversed()));
    matched = match(kcA, kcB, matchingWeights[weights].weight);
}
---

{err ? <ErrorPage {...err}><a href={a ? `/internal/checks/${encodeURIComponent(a.id)}/` : "/"}>{a ? "Back to check" : "Start a new check"}</a></ErrorPage> : a && b && template && matched && weights && <Layout title={`Matcher · ${matchingWeights[weights].name} weights`} maxWidth="1800px">
    <HeaderLogo slot="header">
        <span class="smol">
            {template.name}&nbsp;v{template.revision}
            {" "}{a.id}&nbsp;matched&nbsp;with&nbsp;{b.id} · {matchingWeights[weights].name} weights
        </span>
    </HeaderLogo>
    <RatingOverview slot="header-legend" />
    <MatchForm id={a.id} other={b.id} {weights} />
    <p>{matchingWeights[weights].description} Hard limits always win. If one person chose "i dont know", the other rating is used.</p>
    <p>The resulting KinkCheck is written from {a.id}'s perspective.</p>
    <Check kinks={template.kinks} {...matched} />
</Layout>}

<style>
    p {
        width: fit-content;
        max-width: 65ch;
        margin: 1em auto;
        padding: 0 1rem;
    }
</style>
