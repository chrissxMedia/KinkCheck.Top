---
import Layout from "../../../../layouts/Layout.astro";
import HeaderLogo from "../../../../components/HeaderLogo.astro";
import Main from "../../../../components/Matcher";
import RatingOverview from "../../../../components/RatingOverview.astro";
import { getCurrentTemplate } from "../../../../db";
import { templates } from "../../../../../db/seed";

const { id } = Astro.params;
const template = id && (await getCurrentTemplate(id));

if (!template) {
    return new Response("Template not found", { status: 404 });
}

export async function getStaticPaths() {
	// FIXME:
    return templates.map(({ id }) => ({ params: { id } }));
}
---

<Layout title="Matcher">
	<header>
		<HeaderLogo>Matcher</HeaderLogo>
		<RatingOverview />
	</header>
    <Main {...template.data} client:load />
</Layout>

<style>
	:global(div#content) {
		min-width: 475px;
		max-width: 1800px;
	}
	header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
	}
</style>
