---
import { db, Template } from "astro:db";
import HeaderLogo from "../../../components/HeaderLogo.astro";
import KinkCheck from "../../../components/KinkCheck";
import RatingOverview from "../../../components/RatingOverview.astro";
import { getCurrentTemplate } from "../../../db";
import Layout from "../../../layouts/Layout.astro";

const { id } = Astro.params;
const template = id && (await getCurrentTemplate(id));

if (!template) {
    return new Response("Template not found", { status: 404 });
}

export async function getStaticPaths() {
    const ids = await db.select({ id: Template.id }).from(Template);
    return ids.map(({ id }) => ({ params: { id } }));
}
---

<Layout title={`${template.name} ${template.revision}`}>
    <header>
        <HeaderLogo includeVersion={false}>
            <span class="smol">{template.name}&nbsp;v{template.revision}</span>
        </HeaderLogo>
        <RatingOverview />
    </header>
    <KinkCheck {...template.data} store={template.id} client:only />
</Layout>

<style>
    :global(div#content) {
        min-width: 475px;
        max-width: 1800px;
    }
    header {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
    }
</style>
