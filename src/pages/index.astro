---
import Layout from "../layouts/Layout.astro";
import HeaderLogo from "../components/HeaderLogo.astro";
import KinkCheck from "../components/KinkCheck.astro";
import RatingOverview from "../components/RatingOverview.astro";
import { getCurrentTemplate } from "../db";
import ClearButton from "../components/ClearButton.astro";

const template = await getCurrentTemplate("kcc");
if (!template) {
	throw new Error(`cant find template (should never happen, our db is f-ed)`);
}
---

<Layout screenshotOptions={{ width: 1500 }}>
	<HeaderLogo slot="header">
		<span class="smol">v{template.revision}</span>
	</HeaderLogo>
	<RatingOverview slot="header" />
	<KinkCheck {...template} />
    <ClearButton store={template.id} slot="bottom-nav" />
</Layout>

<style>
	:global(div#content) {
		min-width: 500px;
		max-width: 1800px;
	}
    :global(dialog::backdrop) {
        background-color: rgba(0, 0, 0, 0.5);
    }
</style>
