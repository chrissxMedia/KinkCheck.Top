---
import ErrorPage from "../layouts/ErrorPage.astro";

export const prerender = false;
---

<ErrorPage title="404: Not Found">
    <p slot="detail" class="error">
        The path <code>{Astro.url.pathname}</code> could not be found. If you believe
        this is an error, i.e. a dead link, please <a
            href="https://github.com/chrissxMedia/KinkCheck.Top/issues/new"
        >
            file an issue on GitHub
        </a>.
    </p>
</ErrorPage>

<style>
    :global(html):has(.error) {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }
    code {
        font-family: var(--unifont);
        padding: 2px 8px;
        background: rgb(var(--cmblack));
        border-radius: 4px;
    }
</style>
