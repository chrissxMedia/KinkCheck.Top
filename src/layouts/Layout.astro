---
import { BaseLayout, Footer } from "cmdesigns";
import favicon from "../favicon.png";
import { version } from "../../package.json";
import Sidebar from "../components/Sidebar.astro";
import ScreenshotButton from "../components/ScreenshotButton.astro";
import type { SnapdomOptions } from "@zumer/snapdom";
import { GIT_REF, GIT_SHA } from "astro:env/server";

export interface Props {
    title?: string;
    screenshotOptions?: Partial<SnapdomOptions>;
    minWidth?: string;
    maxWidth?: string;
}

const kc = `KinkCheck.Top v${version}`;
let { title = kc, screenshotOptions, minWidth, maxWidth } = Astro.props;
if (!title.includes(kc)) title += " | " + kc;
let link = "https://github.com/chrissxMedia/KinkCheck.Top";
if (GIT_SHA) link += `/tree/${GIT_SHA}`;
const build = `KinkCheck.Top (${GIT_REF ?? "unknown"}) v${version}-${GIT_SHA?.substring(0, 7) ?? "???????"}`;
const internal = Astro.url.pathname.startsWith("/internal/");
---

<BaseLayout lang="en" {title} {favicon}>
    <div class:list={{ page: internal }}>
        <div id="content" style={{ minWidth, maxWidth }}>
            <header class:list={{ "with-sidebar": internal }}>
                <slot name="header" />
                {internal && <button id="menu-toggle" type="button" aria-label="Toggle navigation" aria-controls="sidebar" aria-expanded="false"></button>}
            </header>
            <slot />
        </div>
        {internal && <Sidebar>
            <slot name="bottom-nav" />
            <ScreenshotButton {title} options={screenshotOptions} />
        </Sidebar>}
    </div>
    <Footer start={2023} {link} {build}>
        {!internal && <nav class="footer-nav">
            {/* <a href="/tutorial">Overview & Tutorial</a> */}
            <a href="/tlcc">Trans Lesbian Badges</a>
            <a href="/flag">Flag Generator</a>
            <a href="/rewind">Rewind</a>
            <a href="/privacy">Privacy Policy</a>
            |
            <slot name="bottom-nav" />
            <ScreenshotButton {title} options={screenshotOptions} />
        </nav>}
    </Footer>
</BaseLayout>

<style>
    /* TODO: Move scrollbar styling to cmdesigns. */
    :global(html) {
        scrollbar-color: #666 #000;
    }
    :global(html::-webkit-scrollbar-track) {
        background: #000;
    }
    :global(html::-webkit-scrollbar-thumb) {
        background: #666;
    }
    .page {
        display: flex;
        align-items: flex-start;
    }
    @media screen and (width >= 1500px) {
        .page:has(#menu-toggle[aria-expanded="true"]) {
            padding-right: 250px;
        }
    }
    div#content {
        flex: 1;
        min-width: 0;
        padding: 12px calc(0.666vw - 4px) 0 calc(0.666vw - 4px);
        margin: 0 auto;
    }
    :global(body.screenshot) div#content {
        flex: none;
    }
    header {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
    }
    header.with-sidebar {
        padding-right: 2.5rem;
    }
    :global(body.screenshot) header {
        padding-right: 0;
    }
    @media screen and (width <= 600px) {
        div#content {
            padding: 0;
        }
    }
    nav.footer-nav {
        display: flex;
        column-gap: 1.25ch;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 0.5em;
    }
    nav.footer-nav :global(a),
    nav.footer-nav :global(a:visited),
    nav.footer-nav :global(.screenshot-button),
    nav.footer-nav :global(button[data-store]),
    nav.footer-nav :global(button[data-template-id]) {
        color: #c0c0c0;
        text-decoration: underline;
        cursor: pointer;
    }
</style>
